{
  "name": "mdkg",
  "version": "0.6.1",
  "description": "Git-native project memory for AI coding agents",
  "license": "MIT",
  "bin": {
    "mdkg": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run deps:preflight && node scripts/clean-build-output.js && tsc -p tsconfig.build.json && node scripts/add-shebang.js && node scripts/copy-init-assets.js && node scripts/generate-command-contract.js --write",
    "build:test": "node scripts/clean-build-output.js tests && tsc -p tsconfig.test.json",
    "test": "npm run build && npm run test:built",
    "test:built": "npm run build:test && node scripts/test-built.js",
    "test:public-release": "node --test tests/public-release.test.mjs tests/publish-readiness-goal-contract.test.mjs tests/security-remediation.test.mjs",
    "security:verify": "node scripts/verify-security-remediation.js",
    "test:coverage": "npm run build && npm run build:test && npm run test:coverage:built",
    "test:coverage:built": "node scripts/coverage-contract.js run",
    "test:coverage:measure": "npm run build && npm run build:test && node scripts/coverage-contract.js measure",
    "smoke:consumer": "npm run build && node scripts/smoke-consumer.js",
    "smoke:git-boundary": "npm run build && node scripts/smoke-git-boundary.js",
    "smoke:loop": "npm run build && node scripts/smoke-loop.js",
    "smoke:matrix": "npm run build && node scripts/smoke-command-matrix.js",
    "smoke:upgrade": "npm run build && node scripts/smoke-upgrade.js",
    "smoke:init": "npm run build && node scripts/smoke-init.js",
    "smoke:capabilities": "npm run build && node scripts/smoke-capabilities.js",
    "smoke:db": "npm run build && node scripts/smoke-db.js",
    "smoke:db-queue": "npm run build && node scripts/smoke-db-queue.js",
    "smoke:db-queue-cli": "npm run build && node scripts/smoke-db-queue-cli.js",
    "smoke:db-events": "npm run build && node scripts/smoke-db-events.js",
    "smoke:db-materializer": "npm run build && node scripts/smoke-db-materializer.js",
    "smoke:db-snapshot": "npm run build && node scripts/smoke-db-snapshot.js",
    "smoke:archive-work": "npm run build && node scripts/smoke-archive-work.js",
    "smoke:work-invocation": "npm run build && node scripts/smoke-work-invocation.js",
    "smoke:cli-ux-polish": "npm run build && node scripts/smoke-cli-ux-polish.js",
    "smoke:operator-health": "npm run build && node scripts/smoke-operator-health.js",
    "smoke:fix-plan": "npm run build && node scripts/smoke-fix-plan.js",
    "smoke:branch-conflicts": "npm run build && node scripts/smoke-branch-conflicts.js",
    "smoke:id-repair": "npm run build && node scripts/smoke-id-repair.js",
    "smoke:command-docs": "npm run build && node scripts/smoke-command-docs.js",
    "smoke:spike": "npm run build && node scripts/smoke-spike.js",
    "smoke:goal-lifecycle": "npm run build && node scripts/smoke-goal-lifecycle.js",
    "smoke:semantic-refs": "npm run build && node scripts/smoke-semantic-refs.js",
    "smoke:checkpoint-templates": "npm run build && node scripts/smoke-checkpoint-templates.js",
    "smoke:handoff": "npm run build && node scripts/smoke-handoff.js",
    "smoke:warning-ux": "npm run build && node scripts/smoke-warning-ux.js",
    "smoke:integration-ux": "npm run build && node scripts/smoke-integration-ux.js",
    "docs:generate": "npm run build && node scripts/generate-docs-reference.js --write && node scripts/generate-release-notes-data.js --write",
    "docs:release-notes": "node scripts/generate-release-notes-data.js --write",
    "docs:release-notes:check": "node scripts/generate-release-notes-data.js --check",
    "docs:check": "npm run build && npm run docs:check:built",
    "docs:check:built": "node scripts/generate-docs-reference.js --check && node scripts/generate-release-notes-data.js --check && node scripts/check-doc-command-examples.js && node scripts/check-cloud-release-plan.js",
    "docs:check-commands": "npm run build && npm run docs:check-commands:built",
    "docs:check-commands:built": "node scripts/check-doc-command-examples.js",
    "smoke:mdkg-dev": "npm run build && node scripts/smoke-mdkg-dev.js",
    "smoke:mdkg-dev-docs": "npm run build && node scripts/smoke-mdkg-dev-docs.js",
    "smoke:mdkg-dev-seo": "npm run build && node scripts/smoke-mdkg-dev-seo.js",
    "smoke:mdkg-dev-polish-pass2": "npm run build && node scripts/smoke-mdkg-dev-polish-pass2.js",
    "smoke:mdkg-dev-polish-pass3": "npm run build && node scripts/smoke-mdkg-dev-polish-pass3.js",
    "smoke:mdkg-dev-polish-pass4": "npm run build && node scripts/smoke-mdkg-dev-polish-pass4.js",
    "smoke:mdkg-dev-polish-pass5": "npm run build && node scripts/smoke-mdkg-dev-polish-pass5.js",
    "smoke:mdkg-dev-a11y": "npm run build && node scripts/smoke-mdkg-dev-a11y.js",
    "smoke:mdkg-dev-perf": "npm run build && node scripts/smoke-mdkg-dev-perf.js",
    "smoke:demo-graph": "npm run build && node scripts/smoke-demo-graph.js",
    "smoke:bundle": "npm run build && node scripts/smoke-bundle.js",
    "smoke:graph-clone": "npm run build && node scripts/smoke-graph-clone.js",
    "smoke:mcp": "npm run build && node scripts/smoke-mcp.js",
    "smoke:bundle-import": "npm run smoke:subgraph",
    "smoke:visibility": "npm run build && node scripts/smoke-visibility.js",
    "smoke:sqlite": "npm run build && node scripts/smoke-sqlite.js",
    "smoke:parallel": "npm run build && node scripts/smoke-parallel.js",
    "smoke:goal": "npm run build && node scripts/smoke-goal.js",
    "cli:snapshot": "npm run build && node scripts/cli_help_snapshot.js",
    "cli:check": "npm run build && npm run cli:check:built",
    "cli:check:built": "node scripts/cli_help_snapshot.js --check",
    "cli:contract": "npm run build && npm run cli:contract:built",
    "cli:contract:built": "node scripts/generate-command-contract.js --check",
    "deps:preflight": "node scripts/dependency-boundary.js preflight",
    "deps:bootstrap": "node scripts/dependency-boundary.js bootstrap",
    "ci:release": "node scripts/release-ladder.js ci",
    "ci:full:prepare": "node scripts/release-ladder.js full-prepare",
    "ci:full:shard": "node scripts/release-ladder.js full-shard",
    "ci:workflow:check": "node scripts/generate-ci-workflow.js --check",
    "ci:workflow:write": "node scripts/generate-ci-workflow.js --write",
    "prepack": "npm run deps:preflight && npm run build && npm run security:verify && node scripts/assert-publish-ready.js",
    "prepublishOnly": "node scripts/release-ladder.js prepublish",
    "postinstall": "node scripts/postinstall.js",
    "smoke:subgraph": "npm run build && node scripts/smoke-subgraph.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.4.0"
  },
  "files": [
    "dist/cli.js",
    "dist/command-contract.json",
    "dist/commands/",
    "dist/core/",
    "dist/graph/",
    "dist/init/",
    "dist/pack/",
    "dist/templates/",
    "dist/util/",
    "scripts/postinstall.js",
    "README.md",
    "CLI_COMMAND_MATRIX.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nickreames/mdkg.git"
  },
  "keywords": [
    "markdown",
    "knowledge-graph",
    "cli"
  ],
  "dependencies": {}
}
