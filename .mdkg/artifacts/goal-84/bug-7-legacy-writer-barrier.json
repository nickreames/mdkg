  "findings": [
    {
      "key": "partial-configuration-barrier",
      "result": "All 16 tested non-init commands under experimental config schema 2 refuse with the newer-schema diagnostic and no filesystem changes.",
      "scope": "Configuration loader guard only; command operations beyond that guard were not qualified by their refusal."
    },
    {
      "key": "old-init-bypass",
      "result": "Old init writes init-manifest despite schema 2. Old init --agent adds 21 file/directory paths before version refusal. Old init --force succeeds, rewrites 15 paths including identity-bearing core and changes config schema back to 1. Not a complete old-writer barrier."
    },
    {
      "key": "warm-cache-partial-mutation",
      "result": "Under unchanged schema 1, old new writes a legacy node and SQLite before error. Old task update changes priority on an existing identity and reorders, but preserves, identity fields before error. Old checkpoint creation succeeds with new legacy evidence. Candidate validation remains required; command failure is not rollback."
    },
    {
      "key": "cache-dependent-failure",
      "result": "Initial copied-cache probes rejected new/show before mutation due to timestamp staleness. Explicit candidate index warming reproduces the hazardous path. Initial 38 cold-cache exploratory cases are retained separately and are not counted as compatibility clearance."
    }
  ],
  "recommendation": {
    "preferred": "Layer a reviewed, explicit v2-adoption configuration contract on the old client's existing newer-schema refusal, AND require all writers to upgrade before v2 adoption. Do not describe config fencing as protection from old init or arbitrary file editing.",
    "implementation_shape": [
      "Keep config schema 1 readable and legacy initialization unchanged. Do not automatically bump existing config during observational reads.",
      "Bind new configuration contract to explicit identity adoption; migration preview names config, manifest and nodes, hashes their inputs, and applies/reverses them through the same recovery journal.",
      "Fail closed on missing/mismatched v2 configuration in new-client mutation paths, with diagnostics and reviewed recovery. No silent identity allocation or automatic repair.",
      "Cover cold/warm caches, old mutation families, old init bypass, migration interruption ordering, repeated migration, mixed-client recovery, clone/fork/reconcile, legacy unchanged reads and supported-runtime matrix.",
      "Keep old-init/direct-editor limitations explicit. Any stronger process/filesystem access barrier belongs to consuming runtime/operator enforcement, not claimed as a portable graph guarantee."
    ],
    "alternatives": [
      "Documentation-only all-writers-upgraded policy: least implementation, but fails to use an available accidental-write defense; not recommended without explicit risk acceptance.",
      "Relocate or hide authored nodes: broad graph/layout/consumer compatibility changes and no general protection from old init; not recommended for this bounded fix.",
      "Git hooks or wrapper-only checks: bypassable and not inherited reliably by every clone; useful optional consumer controls, not the graph correctness boundary."
    ],
    "decision_required": "Nick approval of the layered configuration fence plus no mixed-version writers during v2 adoption, including the explicit old-init limitation. This receipt does not approve or implement it."
  },
  "limitations": [
    "Tested 0.5.2 only; no guarantee for every older executable, custom client or direct editor.",
    "Fixture-only config version experiment, not a released format contract or migration.",
    "No full security review, final runtime matrix, benchmark, artifact seal or publication clearance."
  ],
  "evidence_location": "/private/tmp/mdkg-legacy-barrier.32Ycqs: harness, result JSON and raw synthetic diagnostic logs",
  "authority_used": "Goal83/84 local investigation, owned temporary fixtures, mdkg evidence/projections, reviewed local commit if validation passes",
  "excluded": "No canonical config/identity migration, shipped runtime change, consumer write, remote Git, publication, provider/deployment or bundle refresh.",
  "skill_candidates": []
}
