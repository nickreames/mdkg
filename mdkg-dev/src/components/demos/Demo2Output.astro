---
import type { DemoSnapshot } from "../../data/demos";

const { demo } = Astro.props as { demo: DemoSnapshot };

const stages = [
  {
    id: "01",
    label: "Plan",
    title: "Make intent durable",
    body: "Record the goal, requirements, architecture decisions, and authority before implementation starts.",
    artifact: "goal-1 · prd-2 · dec-1"
  },
  {
    id: "02",
    label: "Work",
    title: "Route the next concrete step",
    body: "Give an agent the selected node and its linked context instead of rebuilding the project story in every chat.",
    artifact: "spike-1 → task-1 → test-1"
  },
  {
    id: "03",
    label: "Evidence",
    title: "Leave proof behind",
    body: "Attach checks, receipts, and checkpoints so another human or agent can see what happened and continue safely.",
    artifact: "validation · receipts · next"
  }
];

const comparison = [
  {
    label: "Reusable starting specification",
    kicker: "SOURCE · goal-1",
    status: demo.sourceGoal.status,
    condition: demo.sourceGoal.condition,
    authority: demo.sourceGoal.authority[0],
    next: "Choose an audience and creative direction."
  },
  {
    label: "Specialized execution specification",
    kicker: "DEMO 2 · goal-1",
    status: demo.executedGoal.status,
    condition: demo.executedGoal.condition,
    authority: demo.executedGoal.authority[1],
    next: "Request a separate rehearsal publication approval."
  }
];

const outcome = [
  {
    label: "What completed",
    value: "A local, inspectable candidate",
    detail: "The specialized graph, creative decision, static site, and validation evidence travel together."
  },
  {
    label: "Why",
    value: "Continuity beats reconstruction",
    detail: "Future agents can recover the decision path without depending on a private transcript."
  },
  {
    label: "What comes next",
    value: "A separate publication gate",
    detail: "Local success does not silently become push or deployment authority."
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={demo.summary} />
    <title>Keep the plan when the agent changes · mdkg</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="nav-shell">
      <a class="brand" href={`/demo/${demo.id}/`} aria-label="Back to Demo 2 graph">
        <span class="brand-mark" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
        <span>mdkg</span>
        <small>public alpha</small>
      </a>
      <nav aria-label="Demo navigation">
        <a href="#route">The route</a>
        <a href="#proof">The proof</a>
        <a href="#next">Try it</a>
      </nav>
    </header>

    <main id="main">
      <section id="top" class="hero" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Markdown Knowledge Graph · Demo 2</p>
          <h1 id="hero-title">Keep the plan when the agent changes.</h1>
          <p class="hero-lede">
            Give coding agents durable requirements, decisions, and
            evidence—stored with the work.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="https://mdkg.dev/quickstart/">Try the quickstart <span aria-hidden="true">↗</span></a>
            <a class="button secondary" href="https://github.com/nickreames/mdkg/issues">Send feedback <span aria-hidden="true">↗</span></a>
          </div>
          <p class="alpha-note">Public alpha · pre-v1 · built in the open</p>
        </div>

        <div class="chart-card" aria-label="Plan Work Evidence navigation chart">
          <div class="chart-head">
            <div>
              <span>PROJECT ROUTE</span>
              <strong>goal-1 / demo-002</strong>
            </div>
            <span class="status"><i></i> local candidate</span>
          </div>
          <div class="chart" aria-hidden="true">
            <span class="latitude l1"></span>
            <span class="latitude l2"></span>
            <span class="latitude l3"></span>
            <span class="route-line"></span>
            <span class="route-glow"></span>
            <span class="waypoint p1"><b>01</b><em>PLAN</em></span>
            <span class="waypoint p2"><b>02</b><em>WORK</em></span>
            <span class="waypoint p3"><b>03</b><em>EVIDENCE</em></span>
          </div>
          <div class="chart-foot">
            <span>39.7392° N</span>
            <span>context: durable</span>
            <span>104.9903° W</span>
          </div>
        </div>
      </section>

      <section class="problem" aria-labelledby="problem-title">
        <p class="section-number">00 / THE HANDOFF</p>
        <div class="problem-copy">
          <h2 id="problem-title">The model remembers the window. Your project needs to remember the work.</h2>
          <p>
            A longer context window helps, but it does not decide which
            requirements matter, why an architecture changed, or what evidence
            makes the next step safe. That context belongs with the project.
          </p>
        </div>
        <aside>
          <span class="aside-label">WITHOUT DURABLE CONTEXT</span>
          <p>Re-explain the plan.</p>
          <p>Rediscover the guardrails.</p>
          <p>Rebuild trust from fragments.</p>
        </aside>
      </section>

      <section id="route" class="route-section" aria-labelledby="route-title">
        <div class="section-heading">
          <div>
            <p class="section-number">01 / THE ROUTE</p>
            <h2 id="route-title">Plan → Work → Evidence</h2>
          </div>
          <p>
            mdkg keeps the lifecycle inspectable as linked Markdown—not trapped
            in one agent session.
          </p>
        </div>

        <div class="route-list">
          {stages.map((stage) => (
            <article class="route-step">
              <div class="route-index">
                <span>{stage.id}</span>
                <i aria-hidden="true"></i>
              </div>
              <div class="route-body">
                <p>{stage.label}</p>
                <h3>{stage.title}</h3>
                <p>{stage.body}</p>
                <code>{stage.artifact}</code>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="proof" class="proof-section" aria-labelledby="proof-title">
        <div class="section-heading">
          <div>
            <p class="section-number">02 / THE PROOF</p>
            <h2 id="proof-title">One goal ID. A much more specific contract.</h2>
          </div>
          <p>
            Reuse the starting specification, then specialize the promise,
            authority, work chain, and tests for the run.
          </p>
        </div>

        <div class="comparison-grid">
          {comparison.map((goal, index) => (
            <article class:list={["goal-card", { specialized: index === 1 }]}>
              <div class="goal-card-head">
                <p>{goal.kicker}</p>
                <span>{goal.status}</span>
              </div>
              <h3>{goal.label}</h3>
              <dl>
                <div>
                  <dt>Condition</dt>
                  <dd>{goal.condition}</dd>
                </div>
                <div>
                  <dt>Authority</dt>
                  <dd>{goal.authority}</dd>
                </div>
                <div>
                  <dt>Next</dt>
                  <dd>{goal.next}</dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
        <p class="proof-note">
          Same lineage. Clearer intent. The source remains reusable while the
          execution graph records what this run actually means.
        </p>
      </section>

      <section class="outcome-section" aria-labelledby="outcome-title">
        <div class="section-heading">
          <div>
            <p class="section-number">03 / THE HANDOFF</p>
            <h2 id="outcome-title">The next agent should not have to guess.</h2>
          </div>
          <p>
            A useful handoff answers three questions before another line of work
            begins.
          </p>
        </div>
        <div class="outcome-grid">
          {outcome.map((item, index) => (
            <article>
              <span>0{index + 1}</span>
              <p>{item.label}</p>
              <h3>{item.value}</h3>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="next" class="cta-section" aria-labelledby="cta-title">
        <div>
          <p class="section-number">04 / YOUR NEXT RUN</p>
          <h2 id="cta-title">Try mdkg on one real project.</h2>
          <p>
            Start with a goal you care about. See whether the plan, decisions,
            and evidence make the next coding session easier to begin.
          </p>
        </div>
        <div class="cta-actions">
          <a class="button light" href="https://mdkg.dev/quickstart/">Open the quickstart <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="https://github.com/nickreames/mdkg/issues">Tell me where it gets in your way <span aria-hidden="true">→</span></a>
        </div>
        <p class="local-stamp">Demo 2 · locally validated candidate · not published</p>
      </section>
    </main>

    <footer>
      <span>mdkg</span>
      <p>Plan the work. Work the plan. Keep the evidence.</p>
      <a href={`/demo/${demo.id}/`}>Inspect the graph <span aria-hidden="true">↗</span></a>
    </footer>
  </body>
</html>

<style>
  :root {
    --paper: #ffffff;
    --mist: #edf8fb;
    --mist-2: #f6fbfd;
    --ink: #0d2033;
    --slate: #3f5568;
    --muted: #5f7485;
    --line: #bfdde7;
    --blue: #0f5fd6;
    --cyan: #0d9bd3;
    --teal: #087f78;
    --teal-bright: #1cc7b5;
    --coral: #ef684b;
    --radius: 6px;
    --shadow: 0 28px 80px rgba(28, 91, 117, 0.13);
    color: var(--ink);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-synthesis: none;
    line-height: 1.5;
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    background: var(--paper);
  }

  body {
    margin: 0;
    min-width: 320px;
    color: var(--ink);
    background:
      linear-gradient(180deg, #eaf8fb 0, #ffffff 44rem),
      var(--paper);
  }

  a { color: inherit; }

  :focus-visible {
    outline: 3px solid var(--coral);
    outline-offset: 4px;
  }

  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 20;
    transform: translateY(-160%);
    border-radius: var(--radius);
    padding: 10px 14px;
    color: white;
    background: var(--ink);
  }

  .skip-link:focus { transform: translateY(0); }

  .nav-shell,
  .hero,
  .problem,
  .proof-section,
  .outcome-section,
  .cta-section,
  footer {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .nav-shell {
    display: flex;
    min-height: 80px;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .brand,
  nav {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 10px;
    font-weight: 850;
    text-decoration: none;
  }

  .brand small {
    border-left: 1px solid var(--line);
    padding-left: 10px;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .brand-mark {
    display: flex;
    width: 31px;
    height: 31px;
    align-items: end;
    gap: 3px;
    border-radius: 50%;
    padding: 7px;
    background: var(--ink);
  }

  .brand-mark span {
    display: block;
    width: 4px;
    border-radius: 3px;
    background: var(--teal-bright);
  }

  .brand-mark span:nth-child(1) { height: 7px; }
  .brand-mark span:nth-child(2) { height: 15px; }
  .brand-mark span:nth-child(3) { height: 11px; }

  nav { gap: 26px; }

  nav a {
    color: var(--slate);
    font-size: 0.9rem;
    font-weight: 720;
    text-decoration: none;
  }

  nav a:hover { color: var(--blue); }

  .hero {
    position: relative;
    display: grid;
    min-height: 680px;
    grid-template-columns: minmax(0, 1.06fr) minmax(400px, 0.94fr);
    align-items: center;
    gap: 64px;
    overflow: hidden;
    padding: 80px 0 96px;
  }

  .hero-grid {
    position: absolute;
    inset: 0 -40vw;
    z-index: -1;
    opacity: 0.46;
    background-image:
      linear-gradient(rgba(15, 95, 214, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 95, 214, 0.07) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: linear-gradient(90deg, black, transparent 78%);
  }

  .eyebrow,
  .section-number {
    margin: 0;
    color: var(--blue);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .eyebrow span {
    width: 34px;
    height: 2px;
    background: var(--coral);
  }

  h1, h2, h3, p { margin-top: 0; }

  h1 {
    max-width: 9ch;
    margin-bottom: 26px;
    font-size: clamp(4rem, 7.8vw, 7rem);
    font-weight: 820;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  h2 {
    margin-bottom: 0;
    font-size: clamp(2.35rem, 5vw, 4.2rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  h3 { letter-spacing: -0.025em; }

  .hero-lede {
    max-width: 590px;
    margin-bottom: 32px;
    color: var(--slate);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
  }

  .hero-actions,
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    padding: 0 20px;
    font-weight: 780;
    text-decoration: none;
  }

  .button.primary {
    color: white;
    background: var(--blue);
    box-shadow: 0 14px 34px rgba(15, 95, 214, 0.22);
  }

  .button.primary:hover { background: #084fb8; }

  .button.secondary {
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.8);
  }

  .alpha-note {
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .chart-card {
    border: 1px solid rgba(15, 95, 214, 0.18);
    border-radius: 10px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px);
  }

  .chart-head,
  .chart-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .chart-head {
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
  }

  .chart-head div {
    display: grid;
    gap: 2px;
  }

  .chart-head span,
  .chart-foot {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chart-head strong { font-size: 0.9rem; }

  .status {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .status i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 4px rgba(8, 127, 120, 0.12);
  }

  .chart {
    position: relative;
    height: 390px;
    overflow: hidden;
    background:
      radial-gradient(circle at 25% 28%, rgba(28, 199, 181, 0.16), transparent 22%),
      linear-gradient(145deg, #fbfeff, #e9f7fa);
  }

  .chart::before {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image:
      linear-gradient(rgba(13, 32, 51, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(13, 32, 51, 0.08) 1px, transparent 1px);
    background-size: 34px 34px;
    content: "";
  }

  .latitude {
    position: absolute;
    width: 74%;
    height: 120px;
    border: 1px solid rgba(13, 155, 211, 0.2);
    border-radius: 50%;
    transform: rotate(-17deg);
  }

  .l1 { top: 15%; left: -12%; }
  .l2 { top: 36%; left: 18%; }
  .l3 { top: 62%; left: 44%; }

  .route-line,
  .route-glow {
    position: absolute;
    top: 54%;
    left: 11%;
    width: 78%;
    height: 4px;
    border-radius: 999px;
    transform: rotate(-12deg);
    transform-origin: center;
  }

  .route-line {
    background: linear-gradient(90deg, var(--blue), var(--cyan), var(--teal-bright));
  }

  .route-glow {
    filter: blur(11px);
    opacity: 0.38;
    background: var(--cyan);
    animation: route-drift 4s ease-in-out infinite alternate;
  }

  .waypoint {
    position: absolute;
    display: grid;
    min-width: 94px;
    grid-template-columns: 31px 1fr;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 8px;
    background: white;
    box-shadow: 0 12px 30px rgba(13, 32, 51, 0.12);
  }

  .waypoint b {
    display: grid;
    width: 31px;
    height: 31px;
    place-items: center;
    border-radius: 4px;
    color: white;
    background: var(--ink);
    font-size: 0.74rem;
  }

  .waypoint em {
    color: var(--slate);
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 850;
    letter-spacing: 0.08em;
  }

  .p1 { top: 57%; left: 8%; }
  .p2 { top: 42%; left: 40%; }
  .p3 { top: 25%; right: 6%; }

  .chart-foot {
    padding: 13px 18px;
    border-top: 1px solid var(--line);
    background: white;
  }

  .problem {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) minmax(250px, 0.45fr);
    gap: 44px;
    padding: 96px 0;
    border-top: 1px solid var(--line);
  }

  .problem-copy h2 { max-width: 820px; }

  .problem-copy > p {
    max-width: 720px;
    margin: 28px 0 0;
    color: var(--slate);
    font-size: 1.15rem;
  }

  .problem aside {
    align-self: end;
    border-left: 3px solid var(--coral);
    padding: 4px 0 4px 22px;
  }

  .problem aside p {
    margin: 6px 0;
    color: var(--slate);
    font-weight: 700;
  }

  .aside-label {
    color: #c14d35;
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.1em;
  }

  .route-section,
  .proof-section,
  .outcome-section {
    padding: 104px 0;
  }

  .route-section {
    width: 100%;
    padding-inline: max(24px, calc((100% - 1180px) / 2));
    background: var(--ink);
    color: white;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.55fr);
    align-items: end;
    gap: 44px;
    margin-bottom: 54px;
  }

  .section-heading > p {
    margin: 0;
    color: var(--slate);
    font-size: 1.05rem;
  }

  .route-section .section-heading > p { color: #b8c9d5; }
  .route-section .section-number { color: var(--teal-bright); }

  .route-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid #2a4154;
    background: #2a4154;
  }

  .route-step {
    min-height: 360px;
    background:
      linear-gradient(180deg, rgba(28, 199, 181, 0.05), transparent 60%),
      #10263a;
  }

  .route-index {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 22px;
    border-bottom: 1px solid #2a4154;
    color: var(--teal-bright);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
  }

  .route-index i {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, var(--teal-bright), transparent);
  }

  .route-body { padding: 32px 28px; }

  .route-body > p:first-child {
    margin-bottom: 44px;
    color: var(--teal-bright);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .route-body h3 {
    margin-bottom: 16px;
    font-size: 1.65rem;
  }

  .route-body h3 + p {
    min-height: 84px;
    color: #b8c9d5;
  }

  .route-body code {
    display: block;
    margin-top: 26px;
    color: #dffbf7;
    font-size: 0.76rem;
  }

  .proof-section {
    background:
      radial-gradient(circle at 90% 15%, rgba(28, 199, 181, 0.12), transparent 24%),
      white;
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .goal-card {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 28px;
    background: var(--mist-2);
  }

  .goal-card.specialized {
    position: relative;
    overflow: hidden;
    border-color: rgba(15, 95, 214, 0.35);
    background: white;
    box-shadow: var(--shadow);
  }

  .goal-card.specialized::after {
    position: absolute;
    top: 0;
    right: 0;
    width: 120px;
    height: 6px;
    background: linear-gradient(90deg, var(--blue), var(--teal-bright));
    content: "";
  }

  .goal-card-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .goal-card-head p,
  .goal-card-head span,
  dt {
    color: var(--blue);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .goal-card-head span { color: var(--muted); }

  .goal-card h3 {
    max-width: 16ch;
    margin: 34px 0;
    font-size: clamp(1.8rem, 3.5vw, 2.7rem);
    line-height: 1.04;
  }

  dl, dd { margin: 0; }

  dl div {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 18px;
    padding: 18px 0;
