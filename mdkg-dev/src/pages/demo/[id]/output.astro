---
import { assertOutputRegistry, getDemoOutputComponent } from "../../../components/demos/outputRegistry";
import { demoSnapshots, type DemoSnapshot } from "../../../data/demos";

assertOutputRegistry(demoSnapshots);

export function getStaticPaths() {
  return demoSnapshots.map((demo) => ({
    params: { id: demo.id },
    props: { demo }
  }));
}

const { demo } = Astro.props as { demo: DemoSnapshot };
const OutputComponent = getDemoOutputComponent(demo.outputComponent);
---

<OutputComponent demo={demo} />
